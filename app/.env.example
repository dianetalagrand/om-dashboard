# Copy this file to .env and fill in real values. Never commit .env — it is git-ignored.
# This file shows the shape of the configuration only. No real value belongs here.

# --- Database ---------------------------------------------------------------
# Local development: a Postgres running on your own machine is fine to start with.
# Production: the instance is not provisioned yet — open question 3 for Nathan.
DATABASE_URL=postgresql://user:password@localhost:5432/om_app

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Admin recognition -----------------------------------------------------
# How the app recognises Diane and Nathan so they get the editing view without
# logging in. The recommendation is Google sign-in limited to two @lastminute.com
# addresses; not yet confirmed. Needed from R2 onward, not before.
# ADMIN_EMAILS=first.last@lastminute.com,second.last@lastminute.com

# --- Notifications ---------------------------------------------------------
# Slack, for the wider team. Not needed until notifications are designed.
# SLACK_WEBHOOK_URL=
